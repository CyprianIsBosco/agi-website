# ── Server ──────────────────────────────────────────
PORT=3001

# ── MongoDB ─────────────────────────────────────────
# Get a free cluster at https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/agi?retryWrites=true&w=majority

# ── Admin ────────────────────────────────────────────
ADMIN_KEY=agi-admin-2025

# ── Email (Nodemailer via Gmail) ──────────────────────
# Create an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@arendgesin.co.ke
SMTP_PASS=your_gmail_app_password

# Email addresses
NOTIFY_TO=info@arendgesin.co.ke       # who receives order/contact notifications
FROM_NAME=Arend Gesin Investment
FROM_EMAIL=info@arendgesin.co.ke

# ── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://arendgesin.co.ke,https://www.arendgesin.co.ke
